{
  "name": "quill",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ./public/index.html",
    "build": "rm -rf dist && bun build ./public/index.html --outdir dist && cp public/_headers dist/",
    "test": "bun test",
    "check": "biome check --write . && bun fmt \"**/*.md\"",
    "check:ci": "biome check . && bun fmt --check \"**/*.md\" && bun --check && bun test",
    "format": "biome format --write . && bun fmt \"**/*.md\"",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-push": "bun run check:ci"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.4.4",
    "simple-git-hooks": "^2.14.0"
  },
  "version": "0.3.2"
}
